# Copy to .env and fill in. Never commit .env.
CDM_RAW_DATA_PATH=data/raw/loans.csv
CDM_PSEUDONYMIZATION_KEY=<generate-a-random-32-byte-hex-string>
# Optional: defaults to sqlite:///<project>/mlruns/mlflow.db (MLflow 3 default backend)
# CDM_MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
CDM_PUSHGATEWAY_URL=127.0.0.1:9091
CDM_LOG_LEVEL=INFO
CDM_RANDOM_SEED=42

# Observability stack (docker compose)
GRAFANA_ADMIN_PASSWORD=<choose-a-local-password>
